{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@waste-x/contracts": ["../packages/contracts/src/index.ts"],
      "@waste-x/validation": ["../packages/validation/src/index.ts"],
      "@waste-x/api-client": ["../packages/api-client/src/index.ts"],
      "@waste-x/operations-core": ["../packages/operations-core/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/contracts/src/**/*.ts",
    "../packages/validation/src/**/*.ts",
    "../packages/api-client/src/**/*.ts",
    "../packages/operations-core/src/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
